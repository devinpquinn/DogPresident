%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a99535a87e8545149a6064a3e9ca9ebd, type: 3}
  m_Name: Squirrels
  m_EditorClassIdentifier: 
  promptText: Rising squirrel populations have become a nuisance to some in city
    parks who wish to eat their lunches in peace.
  responses:
  - headline: Share the parks
    subheading: '"Parks are a space for all of us," says presidential spokesperson,
      "and that means sharing with the squirrels who have lived in those trees for
      generations."'
    approvalEffect: 0
  - headline: War on squirrels
    subheading: President takes an aggressive stance, committing to chase down all
      squirrels; some worry this will only cause greater disturbance in parks nationwide.
    approvalEffect: 3
  - headline: Marking territory
    subheading: President personally deploys first scent marker in a new initiative;
      "These squirrels need to learn that our parks belong to us." Strong scent of
      urine not a concern.
    approvalEffect: 4
  - headline: Parks are for squirrels
    subheading: Woodland creatures lobby celebrates as President announces Squirrel
      Friendship Week, aiming to smooth over cohabitation tensions.
    approvalEffect: 2
  - headline: Prez silent on squirrels
    subheading: Parkgoers shake their heads as President sits on paws; "Maybe it's
      not a major issue to the President, but it's a mild annoyance to me, and I'm
      ready to kill."
    approvalEffect: 3
  - headline: Parks gone nuts!
    subheading: President announces food subsidies for squirrels. "Rather than criminalizing
      snack-seeking behavior, this initiative aims to make it unnecessary."
    approvalEffect: 1
