%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a99535a87e8545149a6064a3e9ca9ebd, type: 3}
  m_Name: OrphanPuncher
  m_EditorClassIdentifier: 
  promptText: Controversial online influencer "IPunchOrphans" is hosting a meetup
    event for his often volatile fanbase right here in Coastal City.
  responses:
  - headline: Heir a-parent
    subheading: Coastal City welcomes wildly popular streamer "IPunchOrphans" with
      open arms, key to city; "It's nice to see there's still at least one politician
      not in the pocket of Big Orphan," influencer enthuses.
    approvalEffect: 4
  - headline: Punching down
    subheading: 'Hackles bared as Mayor denounces firebrand livestreamer "IPunchOrphans"
      ahead of city visit: "There is no place in our city for random acts of provocation
      and violence, even against orphans."'
    approvalEffect: 2
  - headline: Uh-oh, stinky
    subheading: Freak sewage main leak forces internet personality "IPunchOrphans"
      to cancel rally; "I smell sabotage," streamer fumes, "and also I smell doo-doo."
    approvalEffect: 2
  - headline: One-two punch
    subheading: Mayor spotted making surprise appearance at divisive streamer's event;
      "It's the collab of the century," IPunchOrphans exults. "You don't have to
      be a human person to understand that punching orphans is okay."
    approvalEffect: 4
  - headline: Chronically offline
    subheading: 'With divisive internet personality "IPunchOrphans" planning a visit
      to Coastal City, Mayor sidesteps scrutiny by pleading ignorance: "I am a dog."'
    approvalEffect: 0
  - headline: Appetite for violence
    subheading: Catering at convention for orphan-punching personality "IPunchOrphans"
      reportedly paid for by Mayor; "Yes, I used taxpayer funds for this," declares
      official statement.
    approvalEffect: 4
